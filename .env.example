# Copy to .env and fill in only what you have. Everything is optional:
# with nothing configured, the dashboard opens in demo mode.
# Keys can also be pasted into the sidebar for a single session.

# --- Local inference ------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# --- Hosted APIs (set the ones you want to compare against) --------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Any other OpenAI-compatible server (LM Studio, vLLM, llama.cpp) -----
# Use models as custom:<model-id> in the sidebar.
# CUSTOM_OPENAI_BASE_URL=http://localhost:1234/v1
# CUSTOM_OPENAI_API_KEY=

# --- Cost-model defaults (also editable in the sidebar) -------------------
# Whole-system power draw while generating. M-series laptop ~30-60 W, RTX 4090 desktop ~350-500 W.
SLMBENCH_DEVICE_WATTS=60
# Your electricity price in USD per kWh (US average is roughly 0.17).
SLMBENCH_USD_PER_KWH=0.17

# --- Storage ---------------------------------------------------------------
# SLMBENCH_RUNS_DIR=runs
